# Optional: enable the server-side AI documentation assistant.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: repository used by community support on a fork.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-org/your-repo

# Optional: canonical public origin for self-hosting (set before building).
# NEXT_PUBLIC_SITE_URL=https://studio.reex-api.dev

# Optional: prevent indexing on staging or private deployments (build time).
# Vercel preview/development deployments are automatically marked noindex.
# SEO_NOINDEX=true

# Optional: Google Search Console HTML-tag verification token (build time).
# GOOGLE_SITE_VERIFICATION=

# Optional: advanced connected-project configuration.
# API_TARGET_DIR=/absolute/path/to/your/project
# BRIDGE_URL=http://localhost:4000
